{
  "name": "zamolxis",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-convex-bundle.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm typecheck:convex && pnpm test && pnpm test:convex && pnpm build",
    "typecheck:convex": "tsc -p convex/tsconfig.json",
    "test:convex": "vitest run convex tests",
    "codegen:convex": "convex codegen",
    "zamolxis": "pnpm --filter @zamolxis/node cli",
    "deploy:prod": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@auth/core": "0.41.1",
    "@biomejs/biome": "^2.2.4",
    "@convex-dev/auth": "^0.0.96",
    "@types/node": "^22.20.5",
    "@zamolxis/application": "workspace:*",
    "@zamolxis/domain": "workspace:*",
    "@zamolxis/runtime-core": "workspace:*",
    "convex": "^1.28.0",
    "convex-test": "^0.0.60",
    "dotenv": "16.6.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
